NODE_ENV=development
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
# pglite = lokalny PostgreSQL WASM; postgres = serwer PostgreSQL
DATABASE_DRIVER=pglite
PGLITE_DIR=.data/prodflow
# Set this for DATABASE_DRIVER=postgres. Never point migrations at an existing database.
DATABASE_URL=postgresql://prodflow:CHANGE_ME@127.0.0.1:5432/prodflow
POSTGRES_PASSWORD=CHANGE_ME
ALLOW_DEMO_SEED=true
DEMO_PASSWORD=CHANGE_ME
